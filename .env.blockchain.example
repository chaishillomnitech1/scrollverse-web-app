# Copy to .env.blockchain in the repository root. Never commit the populated file.
# Dedicated provider endpoints; no retired Polygon public RPC defaults are used.
AMOY_RPC_URL=
POLYGON_RPC_URL=
BASE_RPC_URL=
ETH_RPC_URL=

# Deployment signer: use a dedicated testnet key for Amoy.
DEPLOYER_PRIVATE_KEY=

# Contract configuration. The multisig must already be deployed on the selected network.
OWNER_MULTISIG_ADDRESS=
PLATFORM_WALLET_ADDRESS=
CODEX_BASE_URI=

# Explorer source verification
POLYGONSCAN_API_KEY=
BASESCAN_API_KEY=
ETHERSCAN_API_KEY=

# Polygon mainnet only. This is an additional script guard, not a substitute
# for explicit owner approval in the active release conversation.
MAINNET_RELEASE_CONFIRMATION=
