# ============================================================
# ScrollVerse Blockchain Deployment — Environment Variables
# Copy this to .env.blockchain and fill in your values
# NEVER commit .env.blockchain to git
# KUN FAYAKUN x Infinity
# ============================================================

# Your deployer wallet private key (the wallet that pays gas)
# SECURITY: Use a dedicated deployment wallet, not your main wallet
DEPLOYER_PRIVATE_KEY=0x_YOUR_PRIVATE_KEY_HERE

# Wallet addresses
ZAKAT_VAULT_ADDRESS=0x_YOUR_ZAKAT_VAULT_WALLET
PLATFORM_WALLET_ADDRESS=0x_YOUR_PLATFORM_WALLET

# Polygon RPC (use Alchemy or Infura for reliability)
POLYGON_RPC_URL=https://polygon-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
AMOY_RPC_URL=https://polygon-amoy.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
BASE_RPC_URL=https://base-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
ETH_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# Infura (alternative to Alchemy)
INFURA_KEY=YOUR_INFURA_PROJECT_ID

# Block explorer API keys (for contract verification)
POLYGONSCAN_API_KEY=YOUR_POLYGONSCAN_API_KEY
BASESCAN_API_KEY=YOUR_BASESCAN_API_KEY
ETHERSCAN_API_KEY=YOUR_ETHERSCAN_API_KEY

# IPFS/Arweave base URI for MetatronCodex metadata
# Upload metadata JSON files to IPFS first, then set this
CODEX_BASE_URI=ipfs://YOUR_IPFS_CID/
